
TEMPERATURE=0.3
MAX_TOKENS=4096
# LLM 服务商通用配置
LLM_API_KEY=sk-xxxxxxxxxxxxxx  # API密钥
LLM_MODEL_ID=deepseek-v4-pro                     # 模型名称
LLM_BASE_URL=https://api.deepseek.com/v1         # 接口地址
LLM_TIMEOUT=60                                    # 请求超时(秒)

# Embedding 模型
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
